{
  "name": "camtrace-demo",
  "version": "1.1.0",
  "description": "CamTrace integration demo — vanilla JS live and record playback",
  "private": true,
  "scripts": {
    "dev":   "webpack serve --mode=development",
    "build": "webpack --mode=production --progress"
  },
  "dependencies": {
    "@camtrace/api":               "file:../../packages/api",
    "@camtrace/decoder":           "file:../../packages/decoder",
    "@camtrace/streaming":         "file:../../packages/streaming",
    "@camtrace/web-video-decoder": "file:../../packages/web-video-decoder"
  },
  "devDependencies": {
    "@babel/core":            "^7.18.0",
    "@babel/preset-env":      "^7.18.0",
    "assert":                 "^2.0.0",
    "babel-loader":           "^8.2.5",
    "browserify-zlib":        "^0.2.0",
    "buffer":                 "^6.0.3",
    "crypto-browserify":      "^3.12.0",
    "css-loader":             "^5.2.7",
    "https-browserify":       "^1.0.0",
    "os-browserify":          "^0.3.0",
    "path-browserify":        "^1.0.1",
    "process":                "^0.11.10",
    "stream-browserify":      "^3.0.0",
    "stream-http":            "^3.2.0",
    "string_decoder":         "^1.3.0",
    "style-loader":           "^3.3.1",
    "tty-browserify":         "^0.0.1",
    "url":                    "^0.11.0",
    "util":                   "^0.12.4",
    "webpack":                "^5.73.0",
    "webpack-cli":            "^4.10.0",
    "webpack-dev-server":     "^4.9.2"
  }
