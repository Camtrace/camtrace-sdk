#%RAML 1.0 DataType

properties:
  position:
    type: "integer"
    format: "int32"
    description: "Position de l'element"
  serverId:
    type: "integer"
    format: "int32"
    description: "Id du serveur de l'element"
  cameraId:
    type: "integer"
    format: "int32"
    description: "Id de camera"
  quality:
    type: "integer"
    format: "int32"
    description: "Qualtiée du flux"
  mode:
    type: "string"
    description: "Mode"
  type:
    type: "string"
    description: "Type"
  url:
    type: "string"
    description: "Url"
  showMargin:
    type: "boolean"
    description: "Afficher les marges"
  showMenu:
    type: "boolean"
    description: "Afficher le menu"
  keepRatio:
    type: "boolean"
    description: "Garder le ratio"
  alignment:
    type: "integer"
    format: "int32"
    description: "Alignement"
